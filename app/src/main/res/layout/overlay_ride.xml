<?xml version="1.0" encoding="utf-8"?>
<!--
  Card da corrida (de um lado ao outro da tela):
  faixa do app no topo (Uber = preta, inDrive = verde-limão) com a nota do passageiro,
  três quadrados (R$/km | Lucro | Mínimo) e "toque para fechar".
  Fundo verde/vermelho definido em RideCardBinder.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Faixa do app: cor da marca para reconhecer de relance. -->
    <LinearLayout
        android:id="@+id/platformStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvPlatform"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 1) R$/km -->
        <br.com.minhacorrida.ui.SquareLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_label_per_km"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvValuePerKm"
                style="@style/CardBigNumber" />

            <TextView
                android:id="@+id/tvDetails"
                style="@style/CardSmallText" />
        </br.com.minhacorrida.ui.SquareLayout>

        <!-- 2) Lucro -->
        <br.com.minhacorrida.ui.SquareLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvProfitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvProfit"
                style="@style/CardBigNumber" />

            <TextView
                android:id="@+id/tvProfitDetails"
                style="@style/CardSmallText" />
        </br.com.minhacorrida.ui.SquareLayout>

        <!-- 3) Valor mínimo da corrida para o R$/km configurado -->
        <br.com.minhacorrida.ui.SquareLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_label_minimum"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMinimumFare"
                style="@style/CardBigNumber" />

            <TextView
                android:id="@+id/tvMinimumLabel"
                style="@style/CardSmallText" />
        </br.com.minhacorrida.ui.SquareLayout>
    </LinearLayout>

    <!-- Destino (bairro, longe/evitar) e volta vazia: preenchido depois, quando o endereço é localizado. -->
    <TextView
        android:id="@+id/tvDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#66000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTapToClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/tap_to_close"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
