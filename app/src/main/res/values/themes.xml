<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo preto, destaques em amarelo (cursor, linha dos campos, diálogos). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/mc_black</item>
        <item name="android:colorPrimaryDark">@color/mc_black</item>
        <item name="android:colorAccent">@color/mc_yellow</item>
        <item name="android:windowBackground">@color/mc_black</item>
        <item name="android:statusBarColor">@color/mc_black</item>
        <item name="android:navigationBarColor">@color/mc_black</item>
        <item name="android:textColorPrimary">@color/mc_text</item>
        <item name="android:textColorSecondary">@color/mc_text_muted</item>
        <item name="android:textColorHint">@color/mc_hint</item>
    </style>

    <!-- Título de cada seção. -->
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/mc_yellow</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rótulo de campo. -->
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/mc_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Campo numérico. -->
    <style name="NumberField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:digits">0123456789,.</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Cartão de seção: fundo grafite com borda amarela suave. -->
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_section</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Item de checklist: verde marcado, vermelho desmarcado. -->
    <style name="CheckItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:buttonTint">@color/check_tint</item>
        <item name="android:textColor">@color/check_tint</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <!-- Botão principal amarelo com texto preto. -->
    <style name="YellowButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:backgroundTint">@color/mc_yellow</item>
        <item name="android:textColor">@color/mc_black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Número grande do card: encolhe sozinho se não couber no quadrado (ex.: 123,45). -->
    <style name="CardBigNumber">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">34sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto pequeno de apoio dentro do quadrado. -->
    <style name="CardSmallText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Aba do topo (Configurações / Simulador); cor trocada em MainActivity.selectTab. -->
    <style name="TabButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Opção Uber/inDrive da corrida de exemplo. -->
    <style name="RadioItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:buttonTint">@color/mc_yellow</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
